# CORE_AUTO / Casa VIP - immagine di produzione.
# Casa VIP gira su PURA STDLIB Python (zero dipendenze): nessuna installazione di
# pacchetti, niente build-tools, immagine minuscola, non-root. Server stdlib (fase83).

# L'immagine base e' bloccata alla sua IMPRONTA (digest), non al solo nome: il nome
# `3.11-slim` punta ogni settimana a un'immagine diversa, e senza impronta due build dello
# stesso commit possono dare due produzioni diverse. E' l'unica dipendenza esterna della
# produzione; l'impronta nuova la propone Dependabot (.github/dependabot.yml) con una PR.
# Questa e' l'immagine del 2026-11-05 (Python 3.11.18), letta dal registro il 2026-11-06
# (prima: quella del 2026-09-01, Python 3.11.16; voce 263 di RIPRENDI, limite (c)).
FROM python:3.11-slim@sha256:65bd3d9f1d7fa268dd1909973ba7eb4bdf41f6dcf2cfbe76ba9528b170f3fd79

# Niente .pyc, output non bufferato (log immediati). TUTTI i dati durevoli su /data
# (il volume): DB + stato scheduler + opt-out outreach. Senza questo, account host,
# crediti referral e disiscrizioni andrebbero persi a ogni redeploy.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORTA=8080 \
    DB_CATALOGO=/data/catalogo.db \
    DB_INVENTARIO=/data/inventario.db \
    DB_REGISTRO_HOST=/data/registro_host.db \
    DB_VIRAL=/data/viral.db \
    CAMPAGNA_STATO_FILE=/data/campagna_stato.json \
    OUTREACH_OPTOUT_FILE=/data/outreach_optout.json \
    STATIC_DIR=/app/deploy

WORKDIR /app

# Solo i file di runtime (i moduli fase*.py sono puro Python; i test NON entrano).
COPY main_casavip.py ./
COPY fase*.py ./
COPY deploy ./deploy

# L'immagine ripulita (15/11/2026, Trivy 0.76.1), poi utente non-root + volume dati.
#  · `apt-get upgrade` porta i pacchetti di Debian GIA' presenti alle correzioni di
#    sicurezza uscite dopo la base (misurato: zlib1g, corretto da Debian e non ancora in
#    nessuna immagine python:3.11-slim). `upgrade` non aggiunge mai un pacchetto nuovo:
#    l'immagine resta senza installazioni. Sta DOPO le COPY apposta: ogni rilascio cambia i
#    file, quindi questo passo si rifa' e non riusa uno strato vecchio dalla cache.
#  · pip, setuptools (col suo jaraco.context), wheel e packaging servono solo a INSTALLARE,
#    e la produzione non installa niente: tolti, escono dieci falle note. Nessun fase*.py e
#    nemmeno main_casavip.py li importa.
#  Lo guarda Trivy nel job `immagine` della CI (test_parita_ambiente, classe Trivy).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel packaging \
    && useradd -r -u 10001 -m -d /home/app app \
    && mkdir -p /data \
    && chown -R app:app /app /data
USER app

EXPOSE 8080
VOLUME ["/data"]

# Healthcheck senza curl (slim non ce l'ha): urllib stdlib
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/api/health',timeout=4).status==200 else 1)"

CMD ["python", "main_casavip.py"]

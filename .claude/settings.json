{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python collaudi/regole_avvio.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(docker-compose:*)",
      "Bash(rm -rf /data:*)",
      "Bash(rm -rf /var/lib/docker/volumes:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Write(./.env)",
      "Write(./.env.casavip)",
      "Edit(./.env)",
      "Edit(./.env.casavip)"
    ]
  }
}

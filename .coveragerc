# Copertura del codice — LIVELLO 2 (righe E rami).
# Si misura SOLO il prodotto vivo: main_casavip.py + i moduli fase*.py raggiungibili
# dall'avvio. Restano fuori i test, gli strumenti d'officina (collaudi/) e l'archivio.
# PRECISAZIONE ONESTA: il vecchio stack Mango/Tavola VIP (fase13-56) resta fuori dalla
# misura perche' e' CODICE MORTO — nessun modulo misurato lo importa ne' lo nomina —
# NON perche' resti fuori dall'immagine: `COPY fase*.py` nel Dockerfile.casavip ce lo
# porta dentro comunque (zavorra, non prodotto). Se un domani tornasse vivo, dovrebbe
# tornare anche sotto misura: lo sorveglia test_copertura_onesta.py, che confronta la
# lista omit qui sotto con la chiusura degli import di produzione.
[run]
branch = True
source = .
omit =
    test_*.py
    collaudi/*
    _archivio/*
    app.py
    fase1?_*.py
    fase2?_*.py
    fase3?_*.py
    fase4?_*.py
    fase5[0-6]_*.py
    setup.py
    */site-packages/*

[report]
# Le righe che non sono codice vero da coprire: guardie di import, rami difensivi
# dichiarati, blocchi __main__.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    except ImportError:
    if TYPE_CHECKING:
show_missing = True
skip_covered = False
precision = 1

[html]
directory = .coverage_html
